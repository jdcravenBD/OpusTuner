{
  "appId": "com.easyastuning.app",
  "appName": "Easy as Tuning",
  "webDir": "dist",
  "backgroundColor": "#07080A",
  "android": {
    "backgroundColor": "#07080A",
    "allowMixedContent": false
  },
  "ios": {
    "backgroundColor": "#07080A",
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#07080A",
      "showSpinner": false
    }
  }
}
